# Supabase (projeto "Big Assessoria", sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://awlhzddymkhcvkgcrcji.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. NUNCA com prefixo NEXT_PUBLIC e nunca no Git.
SUPABASE_SERVICE_ROLE_KEY=

# UAZAPI
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=
# Segredo na URL do webhook: /api/webhooks/uazapi/<instancia>?t=<segredo>
UAZAPI_WEBHOOK_SECRET=

# Número que recebe o WhatsApp quando ainda não há instância ligada ao vendedor (E.164, só dígitos: 5555999999999)
WHATSAPP_PUBLICO=

# Sal para guardar hash de IP (qualquer texto longo e aleatório)
HASH_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Tag Manager (GTM-XXXXXXX). Vazio = sem medição (ambiente local).
NEXT_PUBLIC_GTM_ID=

# Documentos por código (mínimo 24 caracteres aleatórios)
DOCUMENTOS_SECRET=
# Tarefas em segundo plano dentro do container (conversões, alertas). true em produção, com uma réplica só.
JOBS_ATIVOS=false
# Meta Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Google Ads (conversões offline). Precisa de developer token aprovado.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_ACAO_QUALIFICADO=
GOOGLE_ADS_ACAO_DOCUMENTACAO=
GOOGLE_ADS_ACAO_PROPOSTA=
GOOGLE_ADS_ACAO_CONTRATO=
# Importação automática do gasto de anúncios (opcional; sem isso o gasto é lançado à mão no painel)
META_AD_ACCOUNT_ID=
META_ADS_TOKEN=
