# Variáveis da stack no Portainer (Stacks > bigassessoria > Environment variables > Advanced mode > cole).
# Os segredos de verdade não vão para o Git. O arquivo deploy/stack.env (ignorado) é a sua cópia preenchida.

# Imagem (construída pelo GitHub) e domínio
IMAGE=ghcr.io/vozzyup/bigassessoria-site:latest
DOMAIN=big.vozzyup.com.br

# Mesmos valores da stack do Cabeça Leve (rede e Traefik do seu Swarm)
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver

# Supabase (projeto Big Assessoria)
NEXT_PUBLIC_SUPABASE_URL=https://awlhzddymkhcvkgcrcji.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredos do app (gerados)
DOCUMENTOS_SECRET=
HASH_SALT=
UAZAPI_WEBHOOK_SECRET=

# WhatsApp (UAZAPI)
UAZAPI_BASE_URL=
WHATSAPP_PUBLICO=

# Agente de IA
ANTHROPIC_API_KEY=

# Anúncios (deixe em branco até ter)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_AD_ACCOUNT_ID=
META_ADS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_ACAO_QUALIFICADO=
GOOGLE_ADS_ACAO_DOCUMENTACAO=
GOOGLE_ADS_ACAO_PROPOSTA=
GOOGLE_ADS_ACAO_CONTRATO=
